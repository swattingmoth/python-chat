{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: chatbot.py (main entry)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/python_chat/chatbot.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
        "name": "Python: FastAPI + Gradio",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "python": "${workspaceFolder}/.venv/bin/python", // Forces the use of your virtual environment
        "cwd": "${workspaceFolder}/src",
        "args": [
            "python_chat.server:app",
            "--host", "0.0.0.0",
            "--port", "7861",
            "--reload"
        ],
        "jinja": true,
        "console": "integratedTerminal"
        }

    ]
}